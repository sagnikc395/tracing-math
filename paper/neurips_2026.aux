\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Left: held-out boundary AUROC and thresholded first-error F1 at each hidden-state index. The gap is present at every index, including the validation-selected one. Center: mean probe score aligned to the annotated first error, with a 95\% whole-trace bootstrap band. At the onset the mean score is $0.559$, below the operating threshold of $0.645$; it crosses one step later. Right: the 16 source-pair evaluations. AUROC stays above $0.739$ off the diagonal while first-error F1 falls as low as $0.055$.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:gap}{{1}{3}{Left: held-out boundary AUROC and thresholded first-error F1 at each hidden-state index. The gap is present at every index, including the validation-selected one. Center: mean probe score aligned to the annotated first error, with a 95\% whole-trace bootstrap band. At the onset the mean score is $0.559$, below the operating threshold of $0.645$; it crosses one step later. Right: the 16 source-pair evaluations. AUROC stays above $0.739$ off the diagonal while first-error F1 falls as low as $0.055$}{figure.1}{}}
